# v1.0 生产环境变量模板
# 使用方式：复制为 .env.prod 后填入客户真实值。禁止提交 .env.prod。

APP_DOMAIN=shop.example.com
APP_EXTERNAL_BASE_URL=https://shop.example.com
WEB_CORS_ALLOWED_ORIGIN_PATTERNS=https://shop.example.com

MYSQL_DATABASE=shop
MYSQL_ROOT_PASSWORD=<change-me-root-password>
MYSQL_USER=shop_app
MYSQL_PASSWORD=<change-me-db-password>

REDIS_PASSWORD=<change-me-redis-password>

WX_MA_APPID=<customer-miniapp-appid>
WX_MA_SECRET=<customer-miniapp-secret>

WECHAT_PAY_ENABLED=true
WECHAT_PAY_APP_ID=<customer-miniapp-appid>
WECHAT_PAY_MCH_ID=<wechat-pay-merchant-id>
WECHAT_PAY_MERCHANT_SERIAL_NO=<merchant-certificate-serial-no>
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat-pay/apiclient_key.pem
WECHAT_PAY_API_V3_KEY=<32-char-api-v3-key>
WECHAT_PAY_PLATFORM_CERTIFICATE_PATH=/run/secrets/wechat-pay/platform_cert.pem
WECHAT_PAY_NOTIFY_URL=https://shop.example.com/app-api/pay/wechat/notify

TRADE_REFUND_PROVIDER=wechat
TRADE_LOGISTICS_PROVIDER=kuaidi100
KUAIDI100_CUSTOMER=<kuaidi100-customer>
KUAIDI100_KEY=<kuaidi100-key>

TRADE_FREE_FREIGHT_THRESHOLD=19900
TRADE_BASE_FREIGHT_FEE=1000

